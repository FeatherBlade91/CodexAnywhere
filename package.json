{
  "name": "codex-anywhere",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never",
    "pack": "npm run build && electron-builder --win --dir --x64 --publish never",
    "test": "node --test tests/protocol.test.mjs tests/integration.test.mjs tests/restore-stack.test.mjs tests/response-accumulator.test.mjs tests/lifecycle.test.mjs tests/gateway.test.mjs tests/desktop-service.test.mjs tests/network.test.mjs tests/language.test.mjs",
    "test:desktop": "node --test --test-concurrency=1 tests/desktop.e2e.mjs tests/language.e2e.mjs tests/language-restart.e2e.mjs",
    "test:live": "node scripts/live/e2e.mjs"
  },
  "dependencies": {
    "jose": "^6.1.0",
    "openai": "^7.21.0",
    "proper-lockfile": "^4.1.2",
    "undici": "^7.0.0"
  },
  "version": "1.0.0",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "productName": "Codex-Anywhere",
  "description": "One desktop app for ChatGPT subscription connections",
  "author": "NamelessDDDoge",
  "main": "src/desktop/main.mjs",
  "build": {
    "appId": "com.nameless.chatgptbridge",
    "productName": "Codex-Anywhere",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "asarUnpack": [
      "src/core/dpapi.ps1"
    ],
    "files": [
      "src/**/*",
      "vendor/siwc/*.js",
      "vendor/siwc/LICENSE",
      "LICENSE",
      "docs/THIRD-PARTY-NOTICES.md",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Codex-Anywhere-Setup-${version}-${arch}.${ext}",
      "icon": "src/desktop/assets/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": null
  }
}
